# PaperCrew Semantic Scholar proxy (server-side only)
PORT=8787

# Optional. When empty, Semantic Scholar is called anonymously and may return 429.
SEMANTIC_SCHOLAR_API_KEY=

# Comma-separated exact origins. Wildcards are rejected.
# Development default when unset: http://localhost:5173,http://127.0.0.1:5173
# Production must set this explicitly.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional tuning
SEMANTIC_SCHOLAR_TIMEOUT_MS=15000
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW_MS=60000
